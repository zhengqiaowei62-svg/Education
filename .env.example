# ====================================================================
#  学科知识整合智能体 · 环境变量样例
#  复制为 .env 后填入真实 key。请勿把真实 key 提交到仓库。
# --------------------------------------------------------------------
#  说明：
#  - 本项目采用「双 Agent 角色路由」：Extractor（抽取/快） + Judge（裁决/准），
#    再加 Vision（PDF 区块）。每个角色都有独立的 API_KEY / BASE_URL / MODEL，
#    缺省时按 fallback_keys 自动回退（见 backend/utils/llm.py）。
#  - 同一个 ModelScope/OpenAI 账号可用一把 key 兼容三个角色，先填 MODELSCOPE_API_KEY
#    或 OPENAI_API_KEY 即可跑通；进阶请按角色单独配置以便差异化路由。
# ====================================================================


# -------- 0. 通用 / Fallback ----------------------------------------
# 当 EXTRACTOR_API_KEY / JUDGE_API_KEY / VISION_API_KEY 任一未填时，按以下顺序回退：
#   extractor -> MIMO_API_KEY -> QWEN_API_KEY -> MODELSCOPE_API_KEY
#   judge     -> OPENAI_API_KEY -> MODELSCOPE_API_KEY
#   vision    -> MODELSCOPE_API_KEY -> EXTRACTOR_API_KEY
MODELSCOPE_API_KEY=
OPENAI_API_KEY=
# 通用 OpenAI 兼容端点（仅当 JUDGE_BASE_URL 未填时被 judge 角色读取）
OPENAI_BASE_URL=https://api.openai.com/v1
# 通用模型名兜底：当 EXTRACTOR_MODEL / JUDGE_MODEL / VISION_MODEL 都没填时使用
LLM_MODEL=gpt-4o-mini


# -------- 1. Agent A · Extractor（图谱抽取，量大成本敏感） -----------
# 推荐：ModelScope 推理服务 + Qwen3-14B 蒸馏模型；价格低、速度可接受
EXTRACTOR_API_KEY=
EXTRACTOR_BASE_URL=https://ms-ens-f456e73b-c835.api-inference.modelscope.cn/v1
EXTRACTOR_MODEL=TeichAI/Qwen3-14B-Claude-4.5-Opus-High-Reasoning-Distill-GGUF


# -------- 2. Agent B · Judge（融合裁决/RAG 回答，质量优先） ----------
# 推荐：OpenAI gpt-4o-mini 或同等质量端点；用于 merge 决策与 /api/rag/query 生成
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o-mini


# -------- 3. Agent C · Vision（PDF 区块/图像 OCR，可选） --------------
# 用于扫描版 PDF / 公式 / 图表理解；MinerU2.5-Pro 即开即用
VISION_API_KEY=
VISION_BASE_URL=https://ms-ens-1b7b4b03-431b.api-inference.modelscope.cn/v1
VISION_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B


# -------- 4. RAG / Embedding ----------------------------------------
# sentence-transformers 模型名；本地首启会从 HuggingFace 拉取（约 100MB）。
# 不可用时自动降级为 hash embedding + BM25 + 区域检索（见 rag_pipeline.py）。
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 离线 / 镜像加速（HuggingFace 不可达时使用）：
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=./backend/storage/cache/hf


# -------- 5. 网络与超时（可选，按需启用） ---------------------------
# LLM 单次调用超时（秒），ModelScope 冷启动请保留较大值
# LLM_TIMEOUT=120
# 冷启动 425/502 重试次数与最大间隔（utils/llm.py 内置指数退避）
# LLM_COLDSTART_RETRY=10
# LLM_COLDSTART_MAX_BACKOFF=15


# -------- 6. 服务端口（仅 docker-compose 引用） ---------------------
# BACKEND_PORT=8000
# FRONTEND_PORT=8080

