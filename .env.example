# ============ Agent A: Extractor (知识抽取，便宜量大) ============
EXTRACTOR_API_KEY=your-modelscope-token-here
EXTRACTOR_BASE_URL=https://your-modelscope-endpoint/v1
EXTRACTOR_MODEL=TeichAI/Qwen3-14B-Claude-4.5-Opus-High-Reasoning-Distill-GGUF

# ============ Agent B: Judge (裁决+RAG，质量优先) ============
JUDGE_API_KEY=your-modelscope-token-here
JUDGE_BASE_URL=https://your-modelscope-endpoint/v1
JUDGE_MODEL=TeichAI/Qwen3-14B-Claude-4.5-Opus-High-Reasoning-Distill-GGUF

# ============ Vision: MinerU (PDF图像识别，可选) ============
VISION_API_KEY=your-modelscope-token-here
VISION_BASE_URL=https://your-vision-endpoint/v1
VISION_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B

# ============ 兼容 OpenAI 格式（备用） ============
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

